{
  "schema": "ubts.C0_postplan_comparison_expected_protocol.v1",
  "application_enable_environment": {"name": "UBTS_NATIVE_CONTROL_COMPARISON_V1", "default": "0", "explicit_same_release_only": "1"},
  "constructor_default_comparison_provider": null,
  "operation": "control_comparison",
  "request_exact_fields": ["op"],
  "response_comparison_schema": "ubts.native_observation.control_comparison.v1",
  "response_comparison_exact_fields": ["schema", "context", "scan", "imu", "motion", "source_now_ns", "receipt_now_ns"],
  "response_scan_exact_fields": ["sequence", "frame_id", "stamp_ns", "receipt_ns"],
  "response_imu_exact_fields": ["stamp_ns", "receipt_ns"],

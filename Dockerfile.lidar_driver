FROM ros:iron-ros-base

ARG SLLIDAR_ROS2_REPO=https://github.com/Slamtec/sllidar_ros2.git
ARG SLLIDAR_ROS2_REF=34300099fadfc772965962dec837bf436706188f

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    python3-colcon-common-extensions \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/sllidar_ros2_ws

RUN mkdir -p src/sllidar_ros2 \
  && git -C src/sllidar_ros2 init \
  && git -C src/sllidar_ros2 remote add origin "${SLLIDAR_ROS2_REPO}" \
  && git -C src/sllidar_ros2 fetch --depth=1 origin "${SLLIDAR_ROS2_REF}" \
  && git -C src/sllidar_ros2 checkout --detach FETCH_HEAD \
  && . /opt/ros/iron/setup.sh \
  && colcon build --merge-install --cmake-args -DCMAKE_BUILD_TYPE=Release

COPY scripts/run_lidar_driver.sh /usr/local/bin/run_lidar_driver.sh
RUN chmod +x /usr/local/bin/run_lidar_driver.sh

CMD ["/usr/local/bin/run_lidar_driver.sh"]

ARG VISION_AI_BASE_IMAGE=roboflow/roboflow-inference-server-jetson-6.0.0:1.3.2-rc1
FROM ${VISION_AI_BASE_IMAGE}

ARG VISION_AI_INSTALL_REQUIREMENTS=0

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV VISION_AI_HOST=0.0.0.0
ENV VISION_AI_PORT=8785
ENV TRANSFORMERS_OFFLINE=1
ENV HF_HUB_OFFLINE=1

WORKDIR /app

COPY requirements.vision-ai.txt ./

RUN apt-get update \
  && apt-get install -y --no-install-recommends libglib2.0-0 libgl1 \
  && rm -rf /var/lib/apt/lists/*

COPY scripts/vision_ai_service.py ./scripts/vision_ai_service.py
COPY scripts/train_aihub_orchard_tree_yolo.sh ./scripts/train_aihub_orchard_tree_yolo.sh
COPY scripts/validate_vision_worker_frames.py ./scripts/validate_vision_worker_frames.py
COPY scripts/evaluate_orchard_runtime_model.py ./scripts/evaluate_orchard_runtime_model.py

RUN if [ "${VISION_AI_INSTALL_REQUIREMENTS}" = "1" ]; then \
    python -m pip install --no-cache-dir -r requirements.vision-ai.txt; \
  else \
    python -c "import importlib.util; missing=[name for name in ('cv2','numpy') if importlib.util.find_spec(name) is None]; raise SystemExit('Missing runtime modules in base image: %s' % missing if missing else 0)"; \
  fi

RUN mkdir -p /app/runtime/models
RUN chmod +x /app/scripts/train_aihub_orchard_tree_yolo.sh

EXPOSE 8785

HEALTHCHECK --interval=20s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import json, urllib.request; json.load(urllib.request.urlopen('http://127.0.0.1:8785/health', timeout=3))"

ENTRYPOINT []
CMD ["python", "/app/scripts/vision_ai_service.py"]

# Template: replace <user> and <app-dir> (the repository folder on the vehicle).
[Unit]
Description=UBTS Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<user>
Group=<user>
WorkingDirectory=<app-dir>
Environment=DASHBOARD_HOST=0.0.0.0
Environment=DASHBOARD_PORT=8080
Environment=TELEMETRY_FILE=<app-dir>/runtime/telemetry_snapshot.json
ExecStart=/usr/bin/python3 -m dashboard_server --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

# Example unit: replace <user> and <tunnel-name> with the vehicle values before copying it to /etc/systemd/system/.
[Unit]
Description=Cloudflare Tunnel for UNIST Orchard Rover Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<user>
Group=<user>
ExecStart=/usr/local/bin/cloudflared --config /home/<user>/.cloudflared/config.yml tunnel run <tunnel-name>
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

[Unit]
Description=Cloudflare Tunnel for UNIST Orchard Rover Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=unist
Group=unist
ExecStart=/usr/local/bin/cloudflared --config /home/unist/.cloudflared/config.yml tunnel run unist-orachard-dashboard
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

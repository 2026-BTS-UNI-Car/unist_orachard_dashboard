map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen ${AP_ADDRESS}:80;
    # Direct IP access avoids client DNS selection and public-domain HSTS.
    server_name ${AP_ADDRESS} bts.sarihub.com;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto http;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}

server {
    listen ${AP_ADDRESS}:80;
    server_name bts-docker.sarihub.com;

    location / {
        proxy_pass https://127.0.0.1:9443;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto http;
        proxy_ssl_server_name on;
        proxy_ssl_name ${PORTAINER_TLS_NAME};
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate ${PORTAINER_CA_PATH};
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}

server {
    listen ${AP_ADDRESS}:80 default_server;
    server_name _;
    return 404;
}

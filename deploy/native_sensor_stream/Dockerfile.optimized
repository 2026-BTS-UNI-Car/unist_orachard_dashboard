# Sensor-only diagnostics overlay on the reviewed v7 ARM image.
# Its inert command, fixed environment and unchanged CPP observer are inherited.
ARG BASE_IMAGE=sha256:94dd2b79c24b7c8cb02958f5a75edcb56735e678e9a882de5fa01da7ed5d6d06
FROM ${BASE_IMAGE}
ARG PHYSICAL_PACKAGE_SHA
COPY deploy/native_sensor_stream/optimized-package/ /opt/ubts-shadow/package/
COPY deploy/native_sensor_stream/stream_runner.py deploy/native_sensor_stream/stream_rows.py deploy/native_sensor_stream/OBSERVER_CONTRACT.json deploy/native_sensor_stream/build_provenance.py deploy/native_sensor_stream/native_observation_service.py /opt/ubts-native-stream/
COPY deploy/native_sensor_stream/batched_map_owner.py deploy/native_sensor_stream/batched_rays.py deploy/native_sensor_stream/committed_native_map.py deploy/native_sensor_stream/keyframe_registration.py deploy/native_sensor_stream/paired_keyframe_registration.py deploy/native_sensor_stream/pair_visibility.py deploy/native_sensor_stream/native_map_owner.py deploy/native_sensor_stream/native_map_transport.py deploy/native_sensor_stream/stream_rows_map.py deploy/native_sensor_stream/native_pose_ledger.py deploy/native_sensor_stream/NATIVE_MAP_SOURCE.json /opt/ubts-native-stream/
COPY deploy/native_sensor_stream/native_control_input.py /opt/ubts-native-stream/
COPY dashboard_server/body_feedback.py dashboard_server/encoderless_drive_preview.py dashboard_server/native_autonomy_supervisor.py dashboard_server/record_based_autonomy.py /opt/ubts-native-stream/dashboard_server/
COPY deploy/native_sensor_stream/original_topic_graph.py deploy/native_sensor_stream/original_graph_runner.py deploy/native_sensor_stream/ORIGINAL_GRAPH_SOURCE.json /opt/ubts-native-stream/
RUN /usr/bin/python3 -B /opt/ubts-native-stream/build_provenance.py --package-manifest-sha256 "${PHYSICAL_PACKAGE_SHA}" && /bin/bash -c 'source /opt/ros/iron/setup.bash && /opt/ubts-native-stream/bin/actual_cdr_stream && /usr/bin/python3 -B /opt/ubts-native-stream/stream_runner.py && /usr/bin/python3 -B /opt/ubts-native-stream/native_observation_service.py'

# Optional isolated ARM image. Production services are not replaced by this build.
ARG BASE_IMAGE=sha256:7c4e9b3c0762d3db4b5389f4877cb7c76bdd53d5cd66e97fe1d6d1c0d1704815
FROM ${BASE_IMAGE}
USER 0:0
LABEL com.docker.compose.project="ubts-private-native-stream" com.docker.compose.service="observer"
HEALTHCHECK NONE
COPY deploy/native_sensor_stream/observer-src/ /opt/ubts-native-stream/observer-src/
RUN /bin/bash -c 'source /opt/ros/iron/setup.bash && cmake -S /opt/ubts-native-stream/observer-src -B /opt/ubts-native-stream-build -DCMAKE_BUILD_TYPE=Release && cmake --build /opt/ubts-native-stream-build --parallel 1 && install -D -m 0755 /opt/ubts-native-stream-build/actual_cdr_stream /opt/ubts-native-stream/bin/actual_cdr_stream'
COPY deploy/native_sensor_stream/stream_runner.py deploy/native_sensor_stream/stream_rows.py deploy/native_sensor_stream/OBSERVER_CONTRACT.json deploy/native_sensor_stream/build_provenance.py deploy/native_sensor_stream/native_observation_service.py /opt/ubts-native-stream/
COPY dashboard_server/__init__.py dashboard_server/native_owner_lifecycle.py /opt/ubts-native-stream/dashboard_server/
RUN /usr/bin/python3 -B /opt/ubts-native-stream/build_provenance.py
ENV ROS_DOMAIN_ID=0 UBTS_MAP_FIT_WORKERS=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 ROS_LOG_DIR=/tmp/ubts-native-stream/log
RUN /bin/bash -c 'source /opt/ros/iron/setup.bash && /opt/ubts-native-stream/bin/actual_cdr_stream && /usr/bin/python3 -B /opt/ubts-native-stream/stream_runner.py && /usr/bin/python3 -B /opt/ubts-native-stream/native_observation_service.py'
ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["/usr/bin/python3", "-B", "/opt/ubts-native-stream/stream_runner.py"]
